{
  "note": "Describes what a design system contains and how each part may be edited. The studio builds its editors from this file, so a group's `control` is what constrains the UI — a colour group can only ever offer colour controls. Adding a token here adds it to the editor; nothing in the studio is hand-wired.",
  "globals": [
    {
      "id": "accent",
      "label": "Accent colour",
      "control": "color",
      "default": "#1e88ff",
      "note": "Drives the whole accent ramp. The fill used behind white text is derived from this and is forced to clear 4.5:1, so this cannot be set to something that breaks contrast."
    },
    {
      "id": "neutralHue",
      "label": "Neutral hue",
      "control": "hue",
      "min": 0,
      "max": 360,
      "step": 1,
      "default": 220,
      "note": "The hue of every grey. Low numbers warm, ~220 cool blue-grey."
    },
    {
      "id": "neutralChroma",
      "label": "Neutral saturation",
      "control": "number",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 18,
      "note": "0 is pure grey. Higher values tint the surfaces toward the neutral hue."
    },
    {
      "id": "radius",
      "label": "Corner radius",
      "control": "length",
      "unit": "px",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 8,
      "note": "The medium radius. Small, large and extra-large scale from it."
    },
    {
      "id": "spaceUnit",
      "label": "Spacing unit",
      "control": "length",
      "unit": "px",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "note": "The base every spacing step is a multiple of."
    },
    {
      "id": "baseFontSize",
      "label": "Base text size",
      "control": "length",
      "unit": "px",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "id": "typeScale",
      "label": "Type scale",
      "control": "number",
      "min": 1.1,
      "max": 1.45,
      "step": 0.01,
      "default": 1.22,
      "note": "Ratio between steps. 1.2 is gentle, 1.4 is dramatic."
    },
    {
      "id": "fontSans",
      "label": "Interface font",
      "control": "font",
      "default": "system",
      "note": "System stacks only — a mockup must render identically offline, with no font to fetch or licence."
    },
    {
      "id": "fontMono",
      "label": "Monospace font",
      "control": "font",
      "variant": "mono",
      "default": "system-mono"
    },
    {
      "id": "density",
      "label": "Density",
      "control": "select",
      "default": "comfortable",
      "options": [
        { "value": "compact", "label": "Compact — desktop review" },
        { "value": "comfortable", "label": "Comfortable — tablet" },
        { "value": "field", "label": "Field — gloves, sun, ray targeting" }
      ],
      "note": "Sets the hit-target floors. Field pushes every control to 64px."
    },
    {
      "id": "panelOpacity",
      "label": "Panel opacity",
      "control": "alpha",
      "min": 0.4,
      "max": 1,
      "step": 0.01,
      "default": 0.72,
      "note": "How much of the 3D scene shows through a panel. 1 is fully opaque."
    }
  ],
  "groups": [
    {
      "id": "surfaces",
      "label": "Surfaces",
      "control": "color",
      "note": "Numbered by depth. 0 is the backing plane, 3 the nearest layer.",
      "tokens": [
        { "id": "--surface-0", "label": "Backing" },
        { "id": "--surface-1", "label": "Base" },
        { "id": "--surface-2", "label": "Panel" },
        { "id": "--surface-3", "label": "Raised panel" },
        { "id": "--surface-raised", "label": "Hover / control" },
        { "id": "--surface-sunken", "label": "Inset / track" }
      ]
    },
    {
      "id": "text",
      "label": "Text colour",
      "control": "color",
      "tokens": [
        { "id": "--text-primary", "label": "Primary" },
        { "id": "--text-secondary", "label": "Secondary" },
        { "id": "--text-muted", "label": "Muted" },
        { "id": "--text-disabled", "label": "Disabled" },
        { "id": "--text-on-accent", "label": "On accent fill" }
      ]
    },
    {
      "id": "accent",
      "label": "Accent roles",
      "control": "color",
      "note": "Three jobs, three values. Mark for outlines and selection, solid for fills behind white text, fg for accent text on a tinted chip.",
      "tokens": [
        { "id": "--accent", "label": "Mark" },
        { "id": "--accent-hover", "label": "Mark, hover" },
        { "id": "--accent-solid", "label": "Solid fill" },
        { "id": "--accent-fg", "label": "Accent text" }
      ]
    },
    {
      "id": "status",
      "label": "Status colours",
      "control": "color",
      "tokens": [
        { "id": "--status-positive", "label": "Positive" },
        { "id": "--status-positive-fg", "label": "Positive text" },
        { "id": "--status-caution", "label": "Caution" },
        { "id": "--status-caution-fg", "label": "Caution text" },
        { "id": "--status-critical", "label": "Critical" },
        { "id": "--status-critical-fg", "label": "Critical text" },
        { "id": "--status-critical-solid", "label": "Critical fill" }
      ]
    },
    {
      "id": "radius",
      "label": "Corner radius",
      "control": "length",
      "unit": "px",
      "min": 0,
      "max": 40,
      "step": 1,
      "tokens": [
        { "id": "--radius-sm", "label": "Small" },
        { "id": "--radius-md", "label": "Medium" },
        { "id": "--radius-lg", "label": "Large" },
        { "id": "--radius-xl", "label": "Extra large" }
      ]
    },
    {
      "id": "space",
      "label": "Spacing scale",
      "control": "length",
      "unit": "px",
      "min": 0,
      "max": 96,
      "step": 1,
      "tokens": [
        { "id": "--space-1", "label": "1" },
        { "id": "--space-2", "label": "2" },
        { "id": "--space-3", "label": "3" },
        { "id": "--space-4", "label": "4" },
        { "id": "--space-5", "label": "5" },
        { "id": "--space-6", "label": "6" },
        { "id": "--space-7", "label": "7" },
        { "id": "--space-8", "label": "8" }
      ]
    },
    {
      "id": "type",
      "label": "Type scale",
      "control": "length",
      "unit": "px",
      "min": 9,
      "max": 72,
      "step": 1,
      "tokens": [
        { "id": "--text-xs", "label": "Extra small" },
        { "id": "--text-sm", "label": "Small" },
        { "id": "--text-base", "label": "Base" },
        { "id": "--text-lg", "label": "Large" },
        { "id": "--text-xl", "label": "Extra large" },
        { "id": "--text-2xl", "label": "2XL" },
        { "id": "--text-3xl", "label": "3XL" }
      ]
    },
    {
      "id": "fonts",
      "label": "Fonts",
      "control": "font",
      "tokens": [
        { "id": "--font-sans", "label": "Interface" },
        { "id": "--font-mono", "label": "Monospace", "variant": "mono" }
      ]
    },
    {
      "id": "targets",
      "label": "Hit targets",
      "control": "length",
      "unit": "px",
      "min": 24,
      "max": 96,
      "step": 1,
      "note": "The audit enforces --hit-min. Lowering it below 44 will fail every page.",
      "tokens": [
        { "id": "--hit-min", "label": "Minimum" },
        { "id": "--hit-comfortable", "label": "Comfortable" },
        { "id": "--hit-xr", "label": "Ray / field" }
      ]
    },
    {
      "id": "motion",
      "label": "Motion",
      "control": "duration",
      "unit": "ms",
      "min": 0,
      "max": 800,
      "step": 10,
      "tokens": [
        { "id": "--duration-instant", "label": "Instant" },
        { "id": "--duration-fast", "label": "Fast" },
        { "id": "--duration-normal", "label": "Normal" },
        { "id": "--duration-slow", "label": "Slow" }
      ]
    },
    {
      "id": "depth",
      "label": "XR depth",
      "control": "length",
      "unit": "mm",
      "min": 0,
      "max": 120,
      "step": 1,
      "note": "Real z-offsets for the engine build, declared next to the shadows that stand in for them on a flat screen.",
      "tokens": [
        { "id": "--depth-raised", "label": "Raised" },
        { "id": "--depth-float", "label": "Floating" },
        { "id": "--depth-modal", "label": "Modal" }
      ]
    }
  ],
  "fonts": [
    { "value": "system", "label": "System UI", "stack": "\"Inter\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, sans-serif" },
    { "value": "grotesk", "label": "Neo-grotesque", "stack": "\"Helvetica Neue\", Helvetica, \"Segoe UI\", Arial, sans-serif" },
    { "value": "humanist", "label": "Humanist", "stack": "\"Optima\", \"Segoe UI\", \"Gill Sans\", Candara, sans-serif" },
    { "value": "geometric", "label": "Geometric", "stack": "\"Century Gothic\", \"Futura\", \"Avenir Next\", Avenir, sans-serif" },
    { "value": "serif", "label": "Serif", "stack": "\"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif" },
    { "value": "system-mono", "label": "System mono", "stack": "\"JetBrains Mono\", \"Cascadia Code\", ui-monospace, \"SF Mono\", Consolas, monospace", "variant": "mono" },
    { "value": "mono-classic", "label": "Classic mono", "stack": "\"Courier New\", Courier, ui-monospace, monospace", "variant": "mono" }
  ]
}
