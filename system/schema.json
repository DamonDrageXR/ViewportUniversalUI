    {
      "value": "numeral",
      "label": "Numeral / meta (Inter)",
      "stack": "\"Inter\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
      "note": "Aligned digits for charts and tiny meta labels."
    }
  ],
  "rules": [
    {
      "id": "shadows",
      "label": "Elevation",
      "control": "select",
      "default": "soft",
      "options": [
        {
          "value": "soft",
          "label": "Soft shadows"
        },
        {
          "value": "none",
          "label": "None — hierarchy from border, fill, size, spacing"
        }
      ],
      "note": "`none` sets every --shadow-* token to none, so a component that reaches for one gets nothing rather than silently keeping a shadow.",
      "tokens": [
        "--shadow-1",
        "--shadow-2",
        "--shadow-3",
        "--shadow-4"
      ]
    },
    {
      "id": "buttonFill",
      "label": "Button fill",
      "control": "select",
      "default": "accent",
      "options": [
        {
          "value": "accent",
          "label": "Accent fill on the primary action"
        },
        {
          "value": "paper",
          "label": "Paper only — size sets hierarchy, the required action carries a ring"
        }
      ],
      "note": "`paper` is the Paper System rule: no button is ever filled with colour."
    },
    {
      "id": "colourPolicy",
      "label": "Colour policy",
      "control": "select",
      "default": "open",
      "options": [
        {
          "value": "open",
          "label": "Open — accent may carry emphasis anywhere"
        },
        {
          "value": "rationed",
          "label": "Rationed — status and the one required action only"
        }
      ],
      "note": "Audited, not merely documented: `rationed` fails the audit if a colour token is used for decoration."
    },
    {
      "id": "disabledPattern",
      "label": "Disabled treatment",
      "control": "select",
      "default": "dim",
      "options": [
        {
          "value": "dim",
          "label": "Dimmed text and fill"
        },
        {
          "value": "hatch-45",
          "label": "Grey plus a 45° hatch"
        }
      ],
      "note": "A hatch reads as unavailable without relying on contrast, which is why the paper language uses it."
    },
    {
      "id": "themes",
      "label": "Themes",
      "control": "select",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "Dark and light"
        },
        {
          "value": "light-only",
          "label": "Light only"
        },
        {
          "value": "dark-only",
          "label": "Dark only"
        }
      ],
      "note": "A paper system has one ground: white. `light-only` emits the light tokens into :root and the audit stops testing a theme the system does not have."
    },
    {
      "id": "controlFeedback",
      "label": "Hover and press feedback",
      "control": "select",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "Shade the fill"
        },
        {
          "value": "grey-ladder",
          "label": "Grey ladder — for controls that have no fill"
        }
      ],
      "note": "An unfilled control cannot show hover as “a lighter version of the fill”, because there is no fill. `grey-ladder` mixes the steps from the ink token so they stay right in any palette."
    },
    {
      "id": "numeralFace",
      "label": "Numerals",
      "control": "select",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Same face as the interface"
        },
        {
          "value": "mono",
          "label": "Monospace face for anything read as a number"
        }
      ],
      "note": "A hand-drawn or display face has no aligned figures, so a readout, count or measurement set in it is hard to compare down a column. `mono` is an implementation detail of the number, not a second interface typeface."
    },
    {
      "id": "dividerStyle",
      "label": "Dividers",
      "control": "select",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed — reads as drafted, not decided"
        }
      ]
    }
  ]
}
