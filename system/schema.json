{
  "note": "Describes what a design system contains and how each part may be edited. The studio builds its editors from this file, so a group's `control` is what constrains the UI — a colour group can only ever offer colour controls. Adding a token here adds it to the editor; nothing in the studio is hand-wired.",
  "globals": [
    {
      "id": "accent",
      "label": "Accent colour",
      "control": "color",
      "default": "#1e88ff",
      "note": "Drives the whole accent ramp. The fill used behind white text is derived from this and is forced to clear 4.5:1, so this cannot be set to something that breaks contrast."
    },
    {
      "id": "statusPositive",
      "label": "Status — good",
      "control": "color",
      "default": "#1f9d63",
      "note": "The “all clear” hue. Its readable text colour is derived, not picked."
    },
    {
      "id": "statusCaution",
      "label": "Status — marginal",
      "control": "color",
      "default": "#d98a10"
    },
    {
      "id": "statusCritical",
      "label": "Status — poor",
      "control": "color",
      "default": "#d9453f"
    },
    {
      "id": "neutralHue",
      "label": "Neutral hue",
      "control": "hue",
      "min": 0,
      "max": 360,
      "step": 1,
      "default": 220,
      "note": "The hue of every grey. Low numbers warm, ~220 cool blue-grey."
    },
    {
      "id": "neutralChroma",
      "label": "Neutral saturation",
      "control": "number",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 18,
      "note": "0 is pure grey. Higher values tint the surfaces toward the neutral hue."
    },
    {
      "id": "radius",
      "label": "Corner radius",
      "control": "length",
      "unit": "px",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 8,
      "note": "The medium radius. Small, large and extra-large scale from it."
    },
    {
      "id": "lineWeight",
      "label": "Line weight",
      "control": "length",
      "unit": "px",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 1,
      "note": "Base stroke thickness. Borders, dividers and icon strokes all scale from it, so icons thicken with the rest of the system rather than drifting."
    },
    {
      "id": "iconStroke",
      "label": "Icon stroke ratio",
      "control": "number",
      "min": 0.5,
      "max": 2.5,
      "step": 0.1,
      "default": 1.6,
      "note": "Icon stroke as a multiple of the line weight. Icons carry no stroke-width of their own, so this and the line weight together set it — 1.0 keeps icons exactly as heavy as a border."
    },
    {
      "id": "spaceUnit",
      "label": "Spacing unit",
      "control": "length",
      "unit": "px",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "note": "The base every spacing step is a multiple of."
    },
    {
      "id": "baseFontSize",
      "label": "Base text size",
      "control": "length",
      "unit": "px",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "id": "typeScale",
      "label": "Type scale",
      "control": "number",
      "min": 1.1,
      "max": 1.45,
      "step": 0.01,
      "default": 1.22,
      "note": "Ratio between steps. 1.2 is gentle, 1.4 is dramatic."
    },
    {
      "id": "fontSans",
      "label": "Interface font",
      "control": "font",
      "default": "system",
      "note": "System stacks only — a mockup must render identically offline, with no font to fetch or licence."
    },
    {
      "id": "fontMono",
      "label": "Monospace font",
      "control": "font",
      "variant": "mono",
      "default": "system-mono"
    },
    {
      "id": "density",
      "label": "Density",
      "control": "select",
      "default": "comfortable",
      "options": [
        {
          "value": "compact",
          "label": "Compact — desktop review"
        },
        {
          "value": "comfortable",
          "label": "Comfortable — tablet"
        },
        {
          "value": "field",
          "label": "Field — gloves, sun, ray targeting"
        }
      ],
      "note": "Sets the hit-target floors. Field pushes every control to 64px."
    },
    {
      "id": "panelOpacity",
      "label": "Panel opacity",
      "control": "alpha",
      "min": 0.4,
      "max": 1,
      "step": 0.01,
      "default": 0.72,
      "note": "How much of the 3D scene shows through a panel. 1 is fully opaque."
    }
  ],
